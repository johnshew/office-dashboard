VITE_CLIENT_ID=
VITE_TENANT_ID=organizations
# Optional separately hosted device-code service; never put secrets in VITE_ variables.
VITE_DEVICE_LOGIN_URL=
# Optional exact HTTPS origin of independently deployed Phone Link OAuth Worker.
# No Node service needed.
VITE_PHONE_LINK_URL=

# Worker-only bindings are set in wrangler.jsonc / wrangler secret put.
# Never prefix these with VITE_ or put credential values in source control.
# PHONE_CLIENT_ID: separate Entra WEB application, delegated User.Read/Mail.Read/Calendars.Read.
# PHONE_TENANT_ID: organizations, common, consumers, or a tenant UUID.
# PHONE_SERVICE_ORIGIN: exact HTTPS Worker origin, callback /oauth/callback.
# PHONE_CLIENT_SECRET: Worker secret for the WEB application.
# PHONE_ENCRYPTION_KEY: Worker secret, base64url-encoded 32 random bytes.
# PAIRING_DB: D1 binding; apply workers/pairing/schema.sql before enabling.

# Optional Node service configuration (not part of the static build).
DEVICE_CLIENT_ID=
DEVICE_TENANT_ID=organizations
DEVICE_ALLOWED_ORIGINS=http://localhost:8000
HOST=localhost
PORT=8001
