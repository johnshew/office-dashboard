{
    "name": "office-dashboard-pairing",
    "main": "index.js",
    "compatibility_date": "2026-09-13",
    "workers_dev": true,
    "preview_urls": false,
    "vars": {
        "APP_ORIGIN": "https://office-dashboard.shew.net"
    },
    "observability": { "enabled": false },
    "d1_databases": [{
        "binding": "PAIRING_DB",
        "database_name": "office-dashboard-relay",
        "database_id": "42588903-10e5-4f3e-a60c-68dae611e807"
    }],
    "triggers": { "crons": ["* * * * *"] },
    "ratelimits": [{
        "name": "PAIRING_RATE_LIMITER",
        "namespace_id": "1001",
        "simple": { "limit": 60, "period": 60 }
    }]
}