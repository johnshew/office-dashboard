{
    "name": "office-dashboard-phone-link",
    "main": "index.js",
    "compatibility_date": "2026-09-13",
    "workers_dev": true,
    "preview_urls": false,
    "vars": {
        "APP_ORIGIN": "https://office-dashboard.shew.net",
        // Separate Entra WEB registration, callback: https://<worker>/oauth/callback.
        "PHONE_CLIENT_ID": "",
        "PHONE_TENANT_ID": "organizations",
        "PHONE_SERVICE_ORIGIN": ""
    },
    // Required wrangler secrets: PHONE_CLIENT_SECRET and PHONE_ENCRYPTION_KEY.
    // Encryption key: base64url of 32 random bytes, keep stable across restarts.
    // Rotation invalidates existing encrypted sessions; delete phone_slots first.
    "observability": { "enabled": false },
    "d1_databases": [{
        "binding": "PAIRING_DB",
        "database_name": "office-dashboard-phone-link",
        // Set to your D1 database ID; no existing account/database is assumed.
        "database_id": ""
    }],
    "triggers": { "crons": ["* * * * *"] },
    "ratelimits": [{
        "name": "PAIRING_RATE_LIMITER",
        "namespace_id": "1001",
        "simple": { "limit": 120, "period": 60 }
    }]
}
